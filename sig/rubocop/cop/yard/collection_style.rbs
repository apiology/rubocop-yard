module RuboCop
  module Cop
    module YARD
      class CollectionStyle < Base
        include YARD::Helper
        include RangeHelp
        include ConfigurableEnforcedStyle
        extend AutoCorrector

        COLLECTION_NAMES: Hash[String, String]
        SPELLING: Regexp

        def on_new_investigation: () -> void

        private

        def check: (Parser::Source::Comment comment) -> void
        def wrong_style?: (String type, ::YARD::Tags::TypesExplainer::t types_explainer) -> bool
        def collection_count: (::YARD::Tags::TypesExplainer::t types_explainer) -> Integer
        def restyle: (String type) -> String
        def hash_braces: (String type) -> String
        def rewrite_last_hash_angle: (String type) -> String?
        def parses?: (String type) -> bool
        def bad_style: () -> (:short | :long)
        def include_yard_tag?: (Parser::Source::Comment comment) -> bool
      end
    end
  end
end
