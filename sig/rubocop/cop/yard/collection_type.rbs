module RuboCop
  module Cop
    module YARD
      class CollectionType < Base
        include YARD::Helper
        include RangeHelp
        include ConfigurableEnforcedStyle
        extend AutoCorrector

        class Target
          attr_reader type: String
          attr_reader index: Integer
          attr_reader nodes: Array[::YARD::Tags::TypesExplainer::t]
          def initialize: (String type, Integer index, Array[::YARD::Tags::TypesExplainer::t] nodes) -> void
        end

        def on_new_investigation: () -> void

        private

        def check_mismatch_collection_type: (Parser::Source::Comment comment, ::YARD::DocstringParser docstring) -> void
        def check_mismatch_collection_type_one: (Parser::Source::Comment comment, ::YARD::Tags::TypesExplainer::t types_explainer, Target target) -> void
        def correct_collection: (Corrector corrector, Parser::Source::Comment comment, Target target, ::YARD::Tags::TypesExplainer::t node, String? name) -> void
        def include_yard_tag?: (Parser::Source::Comment comment) -> bool
        def tag_range_for_comment: (Parser::Source::Comment comment) -> Parser::Source::Range
      end
    end
  end
end
