module RuboCop
  module Cop
    module YARD
      class CollectionType < Base
        include YARD::Helper
        include RangeHelp
        include ConfigurableEnforcedStyle
        extend AutoCorrector

        class Target
          attr_reader written: String
          attr_reader index_in_tag: Integer
          attr_reader collections: Array[::YARD::Tags::TypesExplainer::t]
          def initialize: (String written, Integer index_in_tag, Array[::YARD::Tags::TypesExplainer::t] collections) -> void
        end

        def on_new_investigation: () -> void

        private

        def check_mismatch_collection_type: (Parser::Source::Comment comment, ::YARD::DocstringParser docstring) -> void
        def check_mismatch_collection_type_one: (Parser::Source::Comment comment, ::YARD::Tags::TypesExplainer::t types_explainer, Target target) -> void
        def rename_collection: (Corrector corrector, Parser::Source::Comment comment, Target target, ::YARD::Tags::TypesExplainer::t node, String name) -> void
        def rewrite_as_hash: (Corrector corrector, Parser::Source::Comment comment, Target target, ::YARD::Tags::TypesExplainer::t node) -> void
        def opener_for: (Target target, Array[[Symbol, Integer, Integer]] tokens, ::YARD::Tags::TypesExplainer::t node) -> [Integer, Integer]?
        def include_yard_tag?: (Parser::Source::Comment comment) -> bool
      end
    end
  end
end
