# Declarations not reflected in gem_rbs_collection (yard 0.9)

# OptionTag inherits Tag at runtime, but gem_rbs_collection declares it without a superclass.
class YARD::Tags::OptionTag
  attr_accessor tag_name: String
  attr_accessor name: String?
end

class YARD::DocstringParser
  # DocstringParser#tags may also hold RefTagList, created from `@param (see #other)`.
  def tags: () -> Array[YARD::Tags::t | YARD::Tags::RefTagList]
          | ...
end

# Added in yard 0.9.46 for `[A, B]`, `A | B` and `A & B` type syntax.
class YARD::Tags::TypesExplainer::GroupType < ::YARD::Tags::TypesExplainer::Type
  attr_accessor types: Array[YARD::Tags::TypesExplainer::t]
end

class YARD::Tags::TypesExplainer::IntersectionType < ::YARD::Tags::TypesExplainer::Type
  attr_accessor types: Array[YARD::Tags::TypesExplainer::t]
end

class YARD::Tags::TypesExplainer::HashCollectionType
  attr_accessor key_value_pairs: Array[[Array[YARD::Tags::TypesExplainer::t], Array[YARD::Tags::TypesExplainer::t]]]
end
